<?xml version="1.0" encoding="utf-8"?>
<!--
  Downloadable-font provider metadata. The certificate values referenced here
  are defined in res/values/font_certs.xml so Compose can use the same trusted
  Google Play Services provider configuration.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="DM Sans" />
